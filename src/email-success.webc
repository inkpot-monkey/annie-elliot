<section id="email-success" class="postcard u-container">
	<h1>Message Sent Successfully</h1>
	<div class="postcard-wrapper">
		<div class="postcard-border">
			<p class="success-message">
				Thank you for your message! Your letter has been posted and I will
				respond as soon as possible.
			</p>
			<a href="/" class="button">Return Home</a>
		</div>
	</div>
</section>

<style>
