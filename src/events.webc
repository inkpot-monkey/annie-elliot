---
metadata:
  title: "Upcoming Book Events | Annie Elliot - Mr & Mrs Charles Dickens"
  description: "Find upcoming book events, readings, and appearances by Annie Elliot, author of Mr & Mrs Charles Dickens, Her Story."
  canonical: "https://annieelliot.co.uk/events/"
  pageType: "events"
---

<section id="events" class="events-section u-container">
	<h1>Upcoming Events</h1>

	<div webc:if="$data.calendar.futureEvents.length > 0">
		<div class="event-wrapper" webc:for="event of $data.calendar.futureEvents">
			<img src="/images/eventFrame.svg" alt="" class="event-frame" />
			<div class="event-card">
				<h3 @text="event.summary"></h3>
				<p><strong>Date: </strong><span @text="event.start"></span></p>
				<p webc:if="event.location">
					<strong>Location: </strong
					><a
						:href="'https://maps.google.com?q=' + (event.location || '')"
						:aria-label="'View location for ' + event.summary"
						><span @text="event.location || 'View Map'"></span
					></a>
				</p>
				<p @text="event.description"></p>
			</div>
		</div>
	</div>

	<div webc:if="$data.calendar.futureEvents.length === 0">
		<p class="no-events">No upcoming events scheduled at this time.</p>
	</div>

	<div webc:if="$data.calendar.pastEvents.length > 0">
		<h2>Past Events</h2>

		<div
			class="event-wrapper is-past"
			webc:for="event of $data.calendar.pastEvents"
		>
			<img src="/images/eventFrame.svg" alt="" class="event-frame" />
			<div class="event-card">
				<h3 @text="event.summary"></h3>
				<p><strong>Date: </strong><span @text="event.start"></span></p>
				<p webc:if="event.location">
					<strong>Location: </strong
					><a
						:href="'https://maps.google.com?q=' + (event.location || '')"
						:aria-label="'View location for ' + event.summary"
						><span @text="event.location || 'View Map'"></span
					></a>
				</p>
				<p @text="event.description"></p>
			</div>
		</div>
	</div>
</section>

<style>
	.events-section {
		padding-block: var(--space-l);
		font-family: var(--font-base);
		text-align: center;

		h1 {
			text-align: center;
			color: var(--taupe);
			margin: 0;
			font-family: var(--font-base);
			margin-bottom: var(--space-l);
		}

		h2 {
			text-align: center;
			color: var(--taupe);
			margin-top: var(--space-l);
			margin-bottom: var(--space-m);
			font-family: var(--font-italic);
			font-style: italic;
			font-size: var(--step-4);
			font-weight: normal;
		}

		.event-wrapper {
			display: grid;
			margin: var(--space-m) auto;
			max-width: 700px;
			padding: var(--space-s);
		}

		.event-wrapper.is-past {
			opacity: 0.7;
		}

		.event-wrapper > * {
			grid-area: 1 / 1;
			width: 100%;
			height: 100%;
		}

		.event-wrapper .event-frame {
			filter: drop-shadow(0 4px 12px var(--shadow-dark));
			object-fit: fill;
			object-position: center;
			pointer-events: none;
			z-index: 1;
			display: block;
		}

		.event-wrapper .event-frame[src$=".svg"] {
			width: 100%;
			height: 100%;
		}

		.event-card {
			background-color: transparent;
			border: none;
			padding: var(--space-2xl) var(--space-xl);
			text-align: center;
			box-shadow: none;
			position: relative;
			z-index: 2;
		}

		.event-card h3 {
			font-family: var(--font-base);
			color: var(--taupe);
			font-size: var(--step-2);
			margin-bottom: var(--space-s);
			margin-top: 0;
		}

		.event-card p {
			font-size: var(--step-0);
			color: var(--taupe);
			line-height: 1.6;
			margin: var(--space-xs) 0;
		}

		.event-card p:last-of-type {
			margin-top: var(--space-xs);
			font-family: var(--font-italic);
			line-height: 1.7;
		}

		.event-card em {
			font-family: var(--font-italic);
			font-style: italic;
		}

		.no-events {
			font-family: var(--font-italic);
			font-style: italic;
			padding: var(--space-s);
		}
	}
</style>
