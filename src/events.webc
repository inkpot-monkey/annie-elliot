---
metadata:
  title: "Upcoming Book Events | Annie Elliot - Mr & Mrs Charles Dickens"
  description: "Find upcoming book events, readings, and appearances by Annie Elliot, author of Mr & Mrs Charles Dickens, Her Story."
  canonical: "https://annieelliot.co.uk/events/"
  pageType: "events"
---

<section id="events" class="events-section u-container">
	<section id="audience-say" class="audience-section">
		<div class="audience-header">
			<h1>What Audiences Say</h1>
			<h2>About Mrs Dickens Telling Her Story</h2>
		</div>

		<div class="featured-testimonial-wrapper">
			<div class="featured-content ornate-frame">
				<p>
					“RIVETING, EXCELLENT, FASCINATING, SPELLBINDING, TRANSFORMATIVE,
					ILLUMINATING, HUMOUROUS BUT HEARTBREAKING”
				</p>
			</div>
		</div>

		<div class="testimonials-grid">
			<div class="testimonial-item">
				<blockquote class="quote">A professional performance.</blockquote>
			</div>
			<div class="testimonial-item">
				<blockquote class="quote">Annie Elliot became Mrs Dickens.</blockquote>
			</div>
			<div class="testimonial-item">
				<blockquote class="quote">
					We didn't want to miss a single word.
				</blockquote>
			</div>
			<div class="testimonial-item">
				<blockquote class="quote">
					A very talented lady who kept us enthralled.
				</blockquote>
			</div>
			<div class="testimonial-item">
				<blockquote class="quote">
					Annie Elliot got right into the character of Mrs Dickens.
				</blockquote>
			</div>
		</div>
	</section>

	<h2 class="section-heading">Upcoming Events</h2>

	<div webc:if="$data.calendar.futureEvents.length > 0">
		<div class="event-wrapper" webc:for="event of $data.calendar.futureEvents">
			<div class="event-card ornate-frame">
				<h3 @text="event.summary"></h3>
				<p webc:if="event.isMultiDay">
					<strong>Dates<span class="label-colon">:</span> </strong
					><span @text="event.start"></span> –
					<span @text="event.end"></span>
				</p>
				<p webc:if="!event.isMultiDay">
					<strong>Date<span class="label-colon">:</span> </strong
					><span @text="event.start"></span>
				</p>
				<p webc:if="event.location">
					<strong>Location<span class="label-colon">:</span> </strong
					><a
						:href="'https://maps.google.com?q=' + (event.location || '')"
						:aria-label="'View location for ' + event.summary"
						><span @text="event.location || 'View Map'"></span
					></a>
				</p>
				<p @text="event.description"></p>
			</div>
		</div>
	</div>

	<div webc:if="$data.calendar.futureEvents.length === 0">
		<p class="no-events">No upcoming events scheduled at this time.</p>
	</div>

	<div webc:if="$data.calendar.pastEvents.length > 0">
		<h2 class="section-heading">Past Events</h2>

		<div
			class="event-wrapper is-past"
			webc:for="event of $data.calendar.pastEvents"
		>
			<div class="event-card ornate-frame">
				<h3 @text="event.summary"></h3>
				<p webc:if="event.isMultiDay">
					<strong>Dates<span class="label-colon">:</span> </strong
					><span @text="event.start"></span> –
					<span @text="event.end"></span>
				</p>
				<p webc:if="!event.isMultiDay">
					<strong>Date<span class="label-colon">:</span> </strong
					><span @text="event.start"></span>
				</p>
				<p webc:if="event.location">
					<strong>Location<span class="label-colon">:</span> </strong
					><a
						:href="'https://maps.google.com?q=' + (event.location || '')"
						:aria-label="'View location for ' + event.summary"
						><span @text="event.location || 'View Map'"></span
					></a>
				</p>
				<p @text="event.description"></p>
			</div>
		</div>
	</div>
</section>

<style>
	/* Shared ornamental frame. Drawn with border-image (a 9-slice) so the four
	   corners keep a fixed size and only the straight edges stretch, each along
	   its own axis. Used the same way everywhere eventFrame.svg wraps content
	   (the featured testimonial and every event card) so the frame never
	   distorts, whatever the height of what it surrounds. */
	.ornate-frame {
		border-style: solid;
		border-width: 46px 40px;
		border-image-source: url("/images/eventFrame.svg");
		border-image-slice: 30% 22%;
		border-image-repeat: stretch;
	}

	.events-section {
		padding-block: var(--space-l);
		font-family: var(--font-base);
		text-align: center;

		.audience-section {
			padding-bottom: var(--space-2xl);
			margin-bottom: var(--space-2xl);
			border-bottom: 1px solid var(--light-beige);
			position: relative;

			.audience-header {
				margin-bottom: var(--space-xl);

				h1 {
					font-family: var(--font-base);
					font-size: var(--step-5);
					color: var(--taupe);
					margin: 0;
					font-weight: 700;
					line-height: 1.1;
					text-transform: none;
					letter-spacing: normal;
				}

				h2 {
					font-family: var(--font-condensed);
					font-size: var(--step-2);
					color: var(--taupe);
					margin-top: var(--space-s);
					margin-bottom: var(--space-xs);
					font-weight: normal;
					font-style: normal;
				}
			}

			.featured-testimonial-wrapper {
				margin: 0 auto var(--space-xl);
				max-width: 900px;
				padding: var(--space-s);
				position: relative;

				.featured-content {
					display: flex;
					align-items: center;
					justify-content: center;

					p {
						font-family: var(--font-base);
						font-size: var(--step-1);
						color: var(--taupe);
						font-weight: 700;
						line-height: 1.4;
						margin: 0;
						text-align: center;
						letter-spacing: 0.05em;
					}

					/* On phones the long all-caps words ("TRANSFORMATIVE,") plus the
					   frame's border-width can push the content wider than the
					   wrapper and overflow the viewport. Shrink the font and drop the
					   letter-spacing so the text — and therefore the frame — fit. */
					@media (max-width: 40rem) {
						p {
							font-size: var(--step-0);
							letter-spacing: normal;
						}
					}
				}
			}

			.testimonials-grid {
				display: flex;
				flex-wrap: wrap;
				justify-content: space-around;
				gap: var(--space-l);
				max-width: 1100px;
				margin-inline: auto;
			}

			.testimonial-item {
				flex: 1 1 320px;
				max-width: 350px;
				margin: 0;
				padding: 2.5rem 3rem;
				border: 1px solid var(--light-beige);
				box-shadow: 3px 3px 10px var(--shadow-light);
				position: relative;
				background-color: transparent;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				transition: all 0.3s ease;

				&:hover {
					box-shadow: 5px 5px 15px var(--shadow-medium);
					transform: translateY(-2px);
				}
			}

			.quote {
				font-family: var(--font-italic);
				font-style: italic;
				line-height: 1.6;
				position: relative;
				margin: 0;
				text-align: center;
				font-size: 1.1rem;
				color: var(--taupe);

				&::before,
				&::after {
					content: "“";
					font-family: serif;
					font-size: 2.5rem;
					position: absolute;
					opacity: 0.3;
					color: var(--taupe);
				}

				&::before {
					left: -1.5rem;
					top: -1.2rem;
				}

				&::after {
					content: "”";
					transform: translateY(-16px);
				}
			}
		}

		h1 {
			text-align: center;
			color: var(--taupe);
			margin: 0;
			font-family: var(--font-base);
			margin-bottom: var(--space-l);
		}

		h2 {
			text-align: center;
			color: var(--taupe);
			margin-top: var(--space-l);
			margin-bottom: var(--space-m);
			font-family: var(--font-italic);
			font-style: italic;
			font-size: var(--step-4);
			font-weight: normal;
		}

		.event-wrapper {
			margin: var(--space-m) auto;
			max-width: 700px;
			padding: var(--space-s);
		}

		/* Past events read as faded, but the fade composites the body text
		   against the cream page: at 0.7 the taupe lands on #7b766c, which is
		   4.33:1 and fails WCAG AA. 0.8 keeps the card visibly dimmed while
		   holding the text above the 4.5:1 floor. */
		.event-wrapper.is-past {
			opacity: 0.8;
		}

		/* Frame comes from .ornate-frame; the border-width supplies the inset, so
		   the card needs no padding of its own. */
		.event-card {
			background-color: transparent;
			text-align: center;
			box-shadow: none;
			position: relative;
		}

		.section-heading {
			font-family: var(--font-base);
			font-size: var(--step-3);
			text-transform: none;
			letter-spacing: normal;
			color: var(--taupe);
			margin-block: var(--space-2xl) var(--space-l);
			position: relative;
			display: block;
			width: fit-content;
			margin-inline: auto;
			text-align: center;
			border-bottom: 1px solid var(--light-beige);
			padding-bottom: var(--space-xs);
		}

		.event-card h3 {
			font-family: var(--font-base);
			color: var(--taupe);
			font-size: var(--step-2);
			margin-bottom: var(--space-xs);
			margin-top: 0;
			font-weight: 700;
			line-height: 1.2;
		}

		.event-card p {
			font-size: var(--step-0);
			color: var(--taupe);
			line-height: 1.6;
			margin: var(--space-xs) 0;
		}

		.event-card p:last-of-type {
			margin-top: var(--space-xs);
			font-family: var(--font-italic);
			line-height: 1.7;
		}

		/* On phones, stack each label above its value ("Date" / "Location" on
		   their own line, colon dropped) so long values — addresses, map links —
		   don't crowd the label on a narrow card. */
		@media (max-width: 40rem) {
			.event-card p strong {
				display: block;
			}

			.event-card p .label-colon {
				display: none;
			}
		}

		.event-card em {
			font-family: var(--font-italic);
			font-style: italic;
		}

		.no-events {
			font-family: var(--font-italic);
			font-style: italic;
			padding: var(--space-s);
		}
	}
</style>
