---
metadata:
  title: "Upcoming Book Events | Annie Elliot - Mr & Mrs Charles Dickens"
  description: "Find upcoming book events, readings, and appearances by Annie Elliot, author of Mr & Mrs Charles Dickens, Her Story."
  canonical: "https://annieelliot.co.uk/events/"
  pageType: "events"
---

<script webc:setup>
  function formatDate(dateTime) {
      if (!dateTime) return 'TBA';
      const date = new Date(dateTime);
      return date.toLocaleDateString('en-GB', {
        weekday: 'long',
        day: 'numeric',
        month: 'long',
        year: 'numeric',
        hour: 'numeric',
        minute: '2-digit'
      });
    }

  async function fetchCalendarEvents() {
    const calendarId = 'author.annie.elliot@gmail.com';
    const apiKey = process.env.CALENDAR_KEY;

    try {
      const response = await fetch(`https://www.googleapis.com/calendar/v3/calendars/${calendarId}/events?key=${apiKey}`);

      if (!response.ok) {
        const errorData = await response.json();
        throw errorData;
      }

      const data = await response.json();
      const events = data.items
        .map(({summary, description, location, start, end}) => {
          const startDt = start.dateTime || start.date;
          const endDt = end?.dateTime || end?.date || null;
          return {
            summary,
            description,
            location,
            start: formatDate(startDt),
            end: formatDate(endDt),
            startDateTime: startDt,
            endDateTime: endDt
          };
        })
        .sort((a, b) => new Date(a.startDateTime) - new Date(b.startDateTime));

      const now = new Date();
      const futureEvents = events.filter(event => new Date(event.startDateTime) > now);
      const pastEvents = events.filter(event => new Date(event.startDateTime) <= now);

      return { futureEvents, pastEvents };
    } catch (error) {
      console.error('Error fetching calendar events:', error);
      throw error;
    }
  }

  let { futureEvents, pastEvents } = await fetchCalendarEvents();
</script>

<section id="events" class="events-section u-container">
  <h1>Upcoming Events</h1>

  <div webc:if="futureEvents.length > 0">
    <div class="event-wrapper" webc:for="event of futureEvents">
      <div class="event-background"></div>
      <img src="/images/eventFrame.svg" alt="" class="event-frame" />
      <div class="event-card">
        <h3 @text="event.summary"></h3>
        <p><strong>Date: </strong><span @text="event.start"></span></p>
        <p webc:if="event.location">
          <strong>Location: </strong
          ><a :href="'https://maps.google.com?q=' + (event.location || '')"
              :aria-label="'View location for ' + event.summary"
            ><span @text="event.location || 'View Map'"></span
          ></a>
        </p>
        <p @text="event.description"></p>
      </div>
    </div>
  </div>

  <div webc:if="futureEvents.length === 0">
    <p class="no-events">No upcoming events scheduled at this time.</p>
  </div>

  <div webc:if="pastEvents.length > 0">
    <h2>Past Events</h2>

    <div class="event-wrapper" webc:for="event of pastEvents">
      <div class="event-background past-event"></div>
      <img src="/images/eventFrame.svg" alt="" class="event-frame" />
      <div class="event-card">
        <h3 @text="event.summary"></h3>
        <p><strong>Date: </strong><span @text="event.start"></span></p>
        <p webc:if="event.location">
          <strong>Location: </strong
          ><a :href="'https://maps.google.com?q=' + (event.location || '')"
              :aria-label="'View location for ' + event.summary"
            ><span @text="event.location || 'View Map'"></span
          ></a>
        </p>
        <p><b @text="event.description"></b></p>
      </div>
    </div>
  </div>
</section>

<style>
  .events-section {
    padding-block: var(--space-l);
    font-family: var(--font-base);
    text-align: center;

    h1 {
      text-align: center;
      color: var(--taupe);
      margin: 0;
      font-family: var(--font-base);
      margin-bottom: var(--space-l);
    }

    h2 {
      text-align: center;
      color: var(--taupe);
      margin-top: var(--space-xl);
      margin-bottom: var(--space-l);
      font-family: var(--font-base);
    }

    .event-wrapper {
      display: grid;
      margin: var(--space-m) auto;
      max-width: 700px;
      padding: var(--space-s);
      filter: drop-shadow(0 4px 12px var(--shadow-dark));
    }

    .event-wrapper > * {
      grid-area: 1 / 1;
      width: 100%;
      height: 100%;
    }

    .event-background {
      background-color: var(--white);
      z-index: 0;
    }

    .event-wrapper .event-frame {
      object-fit: fill;
      object-position: center;
      pointer-events: none;
      z-index: 1;
      display: block;
    }
    
    .event-wrapper .event-frame[src$=".svg"] {
      width: 100%;
      height: 100%;
    }

    .event-card {
      background-color: transparent;
      border: none;
      padding: var(--space-l);
      text-align: center;
      box-shadow: none;
      position: relative;
      z-index: 2;
    }

    .event-card h3 {
      font-family: var(--font-base);
      color: var(--taupe);
      font-size: var(--step-2);
      margin-bottom: var(--space-s);
      margin-top: 0;
    }

    .event-card p {
      font-size: var(--step-0);
      color: var(--taupe);
      line-height: 1.6;
      margin: var(--space-xs) 0;
    }

    .event-card p:last-of-type {
      margin-top: var(--space-m);
      font-family: var(--font-italic);
      line-height: 1.7;
    }

    .event-card em {
      font-family: var(--font-italic);
      font-style: italic;
    }

    .no-events {
      font-family: var(--font-italic);
      font-style: italic;
      padding: var(--space-s);
    }

    .past-event {
      background-color: var(--antiflash-white);
    }
  }
</style>
