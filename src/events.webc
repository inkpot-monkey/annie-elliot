---
metadata:
  title: "Upcoming Book Events | Annie Elliot - Mr & Mrs Charles Dickens"
  description: "Find upcoming book events, readings, and appearances by Annie Elliot, author of Mr & Mrs Charles Dickens, Her Story."
  canonical: "https://annieelliot.co.uk/events/"
  pageType: "events"
---

<section id="events" class="events-section u-container">
	<section id="audience-say" class="audience-section">
		<div class="audience-header">
			<h1>What Audiences Say</h1>
			<h2>About Mrs Dickens Telling Her Story</h2>
		</div>

		<div class="featured-testimonial-wrapper">
			<img src="/images/eventFrame.svg" alt="" class="featured-frame" />
			<div class="featured-content">
				<p>
					“RIVETING, EXCELLENT, FASCINATING, SPELLBINDING, TRANSFORMATIVE,
					ILLUMINATING, HUMOUROUS BUT HEARTBREAKING”
				</p>
			</div>
		</div>

		<div class="testimonials-grid">
			<div class="testimonial-item">
				<blockquote class="quote">A professional performance.</blockquote>
			</div>
			<div class="testimonial-item">
				<blockquote class="quote">Annie Elliot became Mrs Dickens.</blockquote>
			</div>
			<div class="testimonial-item">
				<blockquote class="quote">
					We didn't want to miss a single word.
				</blockquote>
			</div>
			<div class="testimonial-item">
				<blockquote class="quote">
					A very talented lady who kept us enthralled.
				</blockquote>
			</div>
			<div class="testimonial-item">
				<blockquote class="quote">
					Annie Elliot got right into the character of Mrs Dickens.
				</blockquote>
			</div>
		</div>
	</section>

	<h2 class="section-heading">Upcoming Events</h2>

	<div webc:if="$data.calendar.futureEvents.length > 0">
		<div class="event-wrapper" webc:for="event of $data.calendar.futureEvents">
			<img src="/images/eventFrame.svg" alt="" class="event-frame" />
			<div class="event-card">
				<h3 @text="event.summary"></h3>
				<p><strong>Date: </strong><span @text="event.start"></span></p>
				<p webc:if="event.location">
					<strong>Location: </strong
					><a
						:href="'https://maps.google.com?q=' + (event.location || '')"
						:aria-label="'View location for ' + event.summary"
						><span @text="event.location || 'View Map'"></span
					></a>
				</p>
				<p @text="event.description"></p>
			</div>
		</div>
	</div>

	<div webc:if="$data.calendar.futureEvents.length === 0">
		<p class="no-events">No upcoming events scheduled at this time.</p>
	</div>

	<div webc:if="$data.calendar.pastEvents.length > 0">
		<h2 class="section-heading">Past Events</h2>

		<div
			class="event-wrapper is-past"
			webc:for="event of $data.calendar.pastEvents"
		>
			<img src="/images/eventFrame.svg" alt="" class="event-frame" />
			<div class="event-card">
				<h3 @text="event.summary"></h3>
				<p><strong>Date: </strong><span @text="event.start"></span></p>
				<p webc:if="event.location">
					<strong>Location: </strong
					><a
						:href="'https://maps.google.com?q=' + (event.location || '')"
						:aria-label="'View location for ' + event.summary"
						><span @text="event.location || 'View Map'"></span
					></a>
				</p>
				<p @text="event.description"></p>
			</div>
		</div>
	</div>
</section>

<style>
	.events-section {
		padding-block: var(--space-l);
		font-family: var(--font-base);
		text-align: center;

		.audience-section {
			padding-bottom: var(--space-2xl);
			margin-bottom: var(--space-2xl);
			border-bottom: 1px solid var(--light-beige);
			position: relative;

			.audience-header {
				margin-bottom: var(--space-xl);

				h1 {
					font-family: var(--font-base);
					font-size: var(--step-5);
					color: var(--taupe);
					margin: 0;
					font-weight: 700;
					line-height: 1.1;
					text-transform: none;
					letter-spacing: normal;
				}

				h2 {
					font-family: var(--font-condensed);
					font-size: var(--step-2);
					color: var(--taupe);
					margin-top: var(--space-s);
					margin-bottom: var(--space-xs);
					font-weight: normal;
					font-style: normal;
				}
			}

			.featured-testimonial-wrapper {
				display: grid;
				margin: 0 auto var(--space-xl);
				max-width: 900px;
				padding: var(--space-s);
				position: relative;

				& > * {
					grid-area: 1 / 1;
					width: 100%;
					height: 100%;
				}

				.featured-frame {
					filter: drop-shadow(0 4px 20px var(--shadow-dark));
					object-fit: fill;
					pointer-events: none;
					z-index: 1;
				}

				.featured-content {
					z-index: 2;
					display: flex;
					align-items: center;
					justify-content: center;
					padding: var(--space-2xl) var(--space-3xl);

					p {
						font-family: var(--font-base);
						font-size: var(--step-1);
						color: var(--taupe);
						font-weight: 700;
						line-height: 1.4;
						margin: 0;
						text-align: center;
						letter-spacing: 0.05em;
					}
				}
			}

			.testimonials-grid {
				display: flex;
				flex-wrap: wrap;
				justify-content: space-around;
				gap: var(--space-l);
				max-width: 1100px;
				margin-inline: auto;
			}

			.testimonial-item {
				flex: 1 1 320px;
				max-width: 350px;
				margin: 0;
				padding: 2.5rem 3rem;
				border: 1px solid var(--light-beige);
				box-shadow: 3px 3px 10px var(--shadow-light);
				position: relative;
				background-color: transparent;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				transition: all 0.3s ease;

				&:hover {
					box-shadow: 5px 5px 15px var(--shadow-medium);
					transform: translateY(-2px);
				}
			}

			.quote {
				font-family: var(--font-italic);
				font-style: italic;
				line-height: 1.6;
				position: relative;
				margin: 0;
				text-align: center;
				font-size: 1.1rem;
				color: var(--taupe);

				&::before,
				&::after {
					content: "“";
					font-family: serif;
					font-size: 2.5rem;
					position: absolute;
					opacity: 0.3;
					color: var(--taupe);
				}

				&::before {
					left: -1.5rem;
					top: -1.2rem;
				}

				&::after {
					content: "”";
					transform: translateY(-16px);
				}
			}
		}

		h1 {
			text-align: center;
			color: var(--taupe);
			margin: 0;
			font-family: var(--font-base);
			margin-bottom: var(--space-l);
		}

		h2 {
			text-align: center;
			color: var(--taupe);
			margin-top: var(--space-l);
			margin-bottom: var(--space-m);
			font-family: var(--font-italic);
			font-style: italic;
			font-size: var(--step-4);
			font-weight: normal;
		}

		.event-wrapper {
			display: grid;
			margin: var(--space-m) auto;
			max-width: 700px;
			padding: var(--space-s);
		}

		.event-wrapper.is-past {
			opacity: 0.7;
		}

		.event-wrapper > * {
			grid-area: 1 / 1;
			width: 100%;
			height: 100%;
		}

		.event-wrapper .event-frame {
			filter: drop-shadow(0 4px 12px var(--shadow-dark));
			object-fit: fill;
			object-position: center;
			pointer-events: none;
			z-index: 1;
			display: block;
		}

		.event-wrapper .event-frame[src$=".svg"] {
			width: 100%;
			height: 100%;
		}

		.event-card {
			background-color: transparent;
			border: none;
			padding: var(--space-2xl) var(--space-xl);
			text-align: center;
			box-shadow: none;
			position: relative;
			z-index: 2;
		}

		.section-heading {
			font-family: var(--font-base);
			font-size: var(--step-3);
			text-transform: none;
			letter-spacing: normal;
			color: var(--taupe);
			margin-block: var(--space-2xl) var(--space-l);
			position: relative;
			display: block;
			width: fit-content;
			margin-inline: auto;
			text-align: center;
			border-bottom: 1px solid var(--light-beige);
			padding-bottom: var(--space-xs);
		}

		.event-card h3 {
			font-family: var(--font-base);
			color: var(--taupe);
			font-size: var(--step-2);
			margin-bottom: var(--space-xs);
			margin-top: 0;
			font-weight: 700;
			line-height: 1.2;
		}

		.event-card p {
			font-size: var(--step-0);
			color: var(--taupe);
			line-height: 1.6;
			margin: var(--space-xs) 0;
		}

		.event-card p:last-of-type {
			margin-top: var(--space-xs);
			font-family: var(--font-italic);
			line-height: 1.7;
		}

		.event-card em {
			font-family: var(--font-italic);
			font-style: italic;
		}

		.no-events {
			font-family: var(--font-italic);
			font-style: italic;
			padding: var(--space-s);
		}
	}
</style>
