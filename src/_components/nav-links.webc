<script webc:setup>
  // WebC converts kebab-case attributes to camelCase
  // Access attributes (they may be undefined if not provided)
  const fontSizeVal = typeof fontSize !== 'undefined' ? fontSize : 'var(--step-0)';
  const dotColorVal = typeof dotColor !== 'undefined' ? dotColor : 'var(--battleship-gray)';
  const marginVal = typeof margin !== 'undefined' ? margin : '0';
  const navLabelVal = typeof navLabel !== 'undefined' ? navLabel : 'Navigation';
  
  // Link color is always white, underline is always battleship-gray
  const styleVars = `--font-size: ${fontSizeVal}; --dot-color: ${dotColorVal}; --margin: ${marginVal};`;
</script>

<nav 
  class="nav-links" 
  :aria-label="navLabelVal"
  :style="styleVars"
>
  <a href="/">Home</a>
  <span aria-hidden="true">•</span>
  <a href="/author/">Author</a>
  <span aria-hidden="true">•</span>
  <a href="/reviews/">Reviews</a>
  <span aria-hidden="true">•</span>
  <a href="/events/">Events</a>
  <span aria-hidden="true">•</span>
  <a href="/contact/">Contact</a>
</nav>

<style>
  .nav-links {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-xs);
    flex-wrap: wrap;
    text-transform: uppercase;
    margin: var(--margin, 0);
  }
  
  .nav-links a {
    text-decoration: none;
    color: var(--antiflash-white);
    font-size: var(--font-size, var(--step-0));
  }
  
  .nav-links a:hover {
    text-decoration: underline;
    text-decoration-color: var(--battleship-gray);
    text-underline-offset: 2px;
  }
  
  .nav-links span {
    color: var(--dot-color, var(--battleship-gray));
  }
</style>
