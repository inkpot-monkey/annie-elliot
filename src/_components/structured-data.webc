<script webc:setup>
  // Fallback: Generate structured data on-the-fly if not provided by .11tydata.js files
  // This component is used when structuredDataJson is not available from page-specific data files
  let pageType = metadata?.pageType;
  
  if (!pageType && page?.url) {
    if (page.url.includes('/events')) {
      pageType = "events";
    } else if (page.url === "/" || page.url === "" || page.url.endsWith("/index.html")) {
      pageType = "book";
    } else {
      pageType = "website";
    }
  }
  
  if (!pageType) {
    pageType = "website";
  }
  
  const metadataWithPageType = {
    ...(metadata || {}),
    pageType: pageType
  };
  
  let jsonData = '[]';
  try {
    jsonData = await site.getStructuredData(page || {}, metadataWithPageType);
  } catch (error) {
    console.error('Error generating structured data:', error);
    jsonData = '[]';
  }
</script>
<script type="application/ld+json" webc:keep @text="jsonData"></script>