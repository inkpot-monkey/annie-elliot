<script webc:setup>
  // Ensure we get pageType from metadata - prioritize metadata.pageType
  let pageType = metadata?.pageType;
  if (!pageType) {
    // Fallback: check if this is the home page
    const isHomePage = !page?.url || page.url === "/" || page.url === "/index.html" || (page.url && page.url.endsWith("/index.html"));
    pageType = isHomePage ? "book" : "website";
  }
  const metadataWithPageType = { ...metadata, pageType };
  const structuredDataJson = site.getStructuredData(page, metadataWithPageType);
</script>
<script type="application/ld+json" webc:keep @text="structuredDataJson"></script>