<header class="u-container">
	<img
		webc:is="eleventy-image"
		src="assets/images/stamps.webp"
		alt="Two stamps with the faces of a young Mr and Mrs Dickens"
		id="header"
		loading="eager"
		sizes="200px"
	/>

	<nav-links
		nav-label="Main navigation"
		font-size="var(--step-0)"
		dot-color="var(--battleship-gray)"
	></nav-links>
	<img
		webc:is="eleventy-image"
		src="assets/images/separator.webp"
		alt=""
		id="flourish-bottom"
		loading="eager"
		sizes="150px"
	/>
</header>

<style>
	header {
		text-align: center;
		padding-block: var(--space-s);

		#header {
			max-width: var(--img-sm);
			width: 100%;
			height: auto;
			margin: auto;
			padding-bottom: var(--space-s);
		}

		#flourish-bottom {
			max-width: var(--space-3xl);
			margin: auto;
			width: 100%;
			height: auto;
			transform: rotate(180deg);
			padding-bottom: var(--space-s);
		}
	}
</style>
