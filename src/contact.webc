---
metadata:
  title: "Contact Annie Elliot | Author of Mr & Mrs Charles Dickens"
  description: "Get in touch with Annie Elliot, author of Mr & Mrs Charles Dickens, Her Story. Send a message to the author."
  canonical: "https://annieelliot.co.uk/contact/"
  pageType: "contact"
---

<section id="contact" class="postcard u-container">
  <h1>Contact the Author</h1>
  <div class="postcard-wrapper">
    <div class="postcard-border">
      <form action="https://contact.annieelliot.co.uk" method="post">
        <label for="name">Dear Annie, my name is</label>
        <input
          type="text"
          name="name"
          id="name"
          placeholder="Your Name"
          required
        />

        <label for="email">You may reach me at</label>
        <input
          type="email"
          name="email"
          id="email"
          placeholder="your@email.com"
          required
        />

        <label for="message">I wish to say...</label>
        <textarea
          id="message"
          name="message"
          rows="6"
          placeholder="Your message here..."
          required
        ></textarea>

        <button type="submit">Post My Message</button>
      </form>
    </div>
  </div>
</section>

<style>
  .postcard {
    font-family: var(--font-base);
    padding-block: var(--space-l);
    text-align: center;

    h1 {
      text-align: center;
      color: var(--taupe);
      margin: 0;
      font-family: var(--font-base);
      margin-bottom: var(--space-l);
    }

    .postcard-wrapper {
      display: flex;
      justify-content: center;
    }

    .postcard-border {
      border: 4px double var(--taupe);
      padding: var(--space-l);
      max-width: 600px;
      width: 100%;
      background: var(--antiflash-white);
      box-shadow: 5px 5px 20px var(--shadow-medium);
      background-image: url("https://www.transparenttextures.com/patterns/paper-fibers.png");
    }

    & form {
      display: flex;
      flex-direction: column;
      text-align: left;
    }

    & label {
      margin-top: var(--space-s);
      font-family: var(--font-italic);
      font-style: italic;
      font-size: var(--step--1);
      color: var(--black-olive);
    }

    & input,
    & textarea {
      padding: var(--space-xs);
      margin-top: var(--space-3xs);
      font-family: var(--font-base);
      font-size: var(--step-0);
      border: 1px solid var(--battleship-gray);
      background-color: var(--white);
      background-image: none;
      color: var(--black);
    }

    & textarea::placeholder {
      color: var(--taupe);
    }

    & button {
      margin-top: var(--space-l);
      padding: var(--space-xs);
      font-family: var(--font-base);
      background-color: var(--taupe);
      color: var(--antiflash-white);
      border: none;
      font-size: var(--step-0);
      cursor: pointer;
      letter-spacing: 0.5px;
      transition: background-color 0.3s ease;

      &:hover {
        background-color: var(--black-olive);
      }
    }
  }
</style>
