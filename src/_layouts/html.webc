<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title @text="metadata.title"></title>
    <meta name="description" :content="metadata.description" />
    <meta name="author" content="Annie Elliot" />
    <meta name="generator" :content="eleventy.generator" />
    <meta name="creator" content="Pale Blue Bytes" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#a1866f" />
    <link rel="canonical" :href="metadata.canonical || 'https://annieelliot.co.uk' + page.url" />
    
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <link
      rel="icon"
      type="image/png"
      href="/favicon/favicon-96x96.png"
      sizes="96x96"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="shortcut icon" href="/favicon/favicon.ico" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/favicon/apple-touch-icon.png"
    />

    <!-- Structured Data (JSON-LD) -->
    <structured-data></structured-data>

    <link rel="stylesheet" href="reset.css" webc:bucket="base" />
    <link rel="stylesheet" href="design-system.css" webc:bucket="base" />

    <style webc:keep @raw="getBundle('css', 'base')"></style>
    <style webc:keep @raw="getBundle('css')"></style>
  </head>
  <body>
    <header webc:nokeep></header>
    <main @raw="content"></main>
    <footer webc:nokeep></footer>
    <script type="module" webc:keep @raw="getBundle('js')"></script>
  </body>
</html>

<style>
  main {
    background-color: #fefaf2;
  }
</style>
