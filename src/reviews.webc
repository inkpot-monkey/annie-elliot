---
metadata:
  title: "Reviews | Mr & Mrs Charles Dickens: Her Story"
  description: "Read what scholars, authors, and readers are saying about Annie Elliot's historical novel, Mr & Mrs Charles Dickens: Her Story."
---

<section id="reviews-page" class="u-container">
	<h1>Reader Reviews</h1>

	<section id="reviews" class="reviews-section">
		<figure class="review-card" webc:for="review of $data.reviews">
			<blockquote @text="review.quote" class="quote"></blockquote>
			<figcaption @raw="review.source" class="reviewer"></figcaption>
		</figure>
	</section>

	<h2>Photo Gallery</h2>

	<!--
		Justified rows. `gallery.js` freezes the row BREAKS at a 1160px container
		(DP packer) and emits each photo's displayed aspect ratio as `--r`; each
		row is a flex container whose items carry `flex: var(--r) 1 0`, so the
		row's whole width is distributed in proportion to ratio and every item
		lands at the identical height at its exact aspect. One packing serves
		every viewport — the widths stay fluid, only the height changes.
		Nothing is cropped, so there is no aspect-ratio and no object-fit.

		The caption is the photo's text alternative and is rendered ONCE, by the
		figcaption: the link takes a short positional name and points at it with
		aria-describedby, and both <img> tags carry alt="". An aria-label on the
		anchor does NOT suppress a descendant image's alt — Chrome exposes it as
		its own node — which is how the same sentence used to be announced three
		times per thumbnail.
	-->
	<section class="photo-gallery" id="gallery">
		<div class="row" webc:for="row of $data.gallery.rows" :style="`--sum: ${row.reduce((s, item) => s + item.ratio, 0).toFixed(4)}`">
			<figure class="gallery-item" webc:for="item of row" :style="`--r: ${item.ratio.toFixed(4)}`">
				<a
					class="thumb"
					:href="`#photo-${item.index}`"
					:aria-label="`Enlarge photo ${item.index + 1} of ${$data.gallery.photos.length}`"
					:aria-describedby="`cap-${item.index}`"
				>
					<img
						webc:is="eleventy-image"
						:src="item.src"
						alt=""
						width="400, 640, 800, 1300, 1800"
						:sizes="`(min-width: 77.5rem) ${Math.round(item.share * (1160 - 8 * (item.rowCount - 1)))}px, (min-width: 40rem) ${Math.round(item.share * 100)}vw, 100vw`"
					/>
				</a>
				<figcaption :id="`cap-${item.index}`" @text="item.caption"></figcaption>
			</figure>
		</div>
	</section>

	<!--
		Pure CSS/HTML lightbox (no JavaScript): one overlay per photo, revealed by
		:target when its `#photo-N` hash is active. Prev/next/close are plain anchors;
		the backdrop is a full-viewport close link. Keeps the site script-free.
	-->
	<div class="lightbox" webc:for="(item, i) of $data.gallery.photos" :id="`photo-${i}`" role="dialog" aria-label="Photo viewer">
		<a class="lb-backdrop" href="#gallery" aria-label="Close viewer" tabindex="-1"></a>
		<figure class="lb-frame">
			<div class="lb-stage">
				<a class="lb-close" href="#gallery" aria-label="Close viewer">
					<svg class="lb-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6 L18 18 M18 6 L6 18" /></svg>
				</a>
				<a class="lb-btn lb-prev" :href="`#photo-${(i - 1 + $data.gallery.photos.length) % $data.gallery.photos.length}`" aria-label="Previous photo">
					<svg class="lb-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 6 L9 12 L15 18" /></svg>
				</a>
				<!--
					The frame is capped at min(72rem, 100% - padding) and the image is
					`max-height: 78vh; width: auto`, so its rendered width is HEIGHT-driven
					— the old `90vw` over-declared by ~2.5x and pulled the source-width
					rendition. `lazy` (not eager) because a lazy image inside `display: none`
					never loads: this took ~5.9 MB of upfront payload off /reviews/ to zero,
					and lb-pulse/lb-reveal already cover the moment it does load.
				-->
				<img
					webc:is="eleventy-image"
					:src="item.src"
					alt=""
					width="400, 640, 800, 1300, 1800"
					:sizes="`min(72rem, 100vw - 2.5rem, 78vh * ${item.ratio.toFixed(4)})`"
					loading="lazy"
				/>
				<a class="lb-btn lb-next" :href="`#photo-${(i + 1) % $data.gallery.photos.length}`" aria-label="Next photo">
					<svg class="lb-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 6 L15 12 L9 18" /></svg>
				</a>
			</div>
			<figcaption class="lb-cap">
				<span @text="item.caption"></span>
				<span class="lb-count" @text="`${i + 1} / ${$data.gallery.photos.length}`"></span>
			</figcaption>
		</figure>
	</div>

	<style>
		#reviews-page {
			padding-block: var(--space-l);

			h1 {
				text-align: center;
				color: var(--taupe);
				margin: 0;
				font-family: var(--font-base);
				margin-bottom: var(--space-l);
			}
		}

		#reviews {
			display: grid;
			grid-template-columns: 1fr;
			@media (min-width: 40rem) {
				grid-template-columns: repeat(2, 1fr);
			}
			align-items: center;
			gap: var(--space-l);
			padding-bottom: var(--space-xl);

			.review-card {
				margin: 0;
				padding: 1.5rem 2rem;
				border: 1px solid var(--light-beige);
				box-shadow: 3px 3px 10px var(--shadow-light);
				position: relative;
				font-size: 1.1rem;
				display: flex;
				flex-direction: column;
			}

			.quote {
				font-family: var(--font-italic);
				font-style: italic;
				line-height: 1.6;
				position: relative;
				margin: 0;
				text-align: left;
			}

			.quote::before,
			.quote::after {
				content: "“";
				font-family: serif;
				font-size: 2.5rem;
				position: absolute;
				opacity: 0.3;
			}

			.quote::before {
				left: -1.5rem;
				top: -1.2rem;
			}

			.quote::after {
				content: "”";
				transform: translateY(-16px);
			}

			.reviewer {
				margin-top: 1rem;
				text-align: right;
				font-style: normal;
				font-size: 0.9rem;

				a {
					font-style: italic;
					font-size: inherit;
				}
			}
		}

		h2 {
			text-align: center;
			color: var(--taupe);
			margin-top: var(--space-l);
			margin-bottom: var(--space-m);
			font-family: var(--font-italic);
			font-style: italic;
			font-size: var(--step-4);
			font-weight: normal;
		}

		/* ---- gallery (justified rows, tight mosaic — nothing is cropped) ---- */
		.photo-gallery {
			/* Must track ROW_GAP in src/_data/gallery.js, which packs against 8px. */
			--gap: var(--space-2xs);

			display: flex;
			flex-direction: column;
			gap: var(--gap);

			.row {
				display: flex;
				gap: var(--gap);
				/* Safety valve for a degenerate gallery. The packer has no choice with
				   one or two photos, and a lone photo would become a ~1500px-tall
				   full-width slab; this caps a row at 1.5x the target row height.
				   Never fires for the current eleven (measured). */
				max-width: calc(1.5 * 22rem * var(--sum));
			}

			.gallery-item {
				margin: 0;
				position: relative; /* the caption scrim is positioned against this */
				/* basis 0 + grow proportional to ratio => every item on the row lands
				   at the same height at its exact aspect, with no calc and no rounding */
				flex: var(--r) 1 0;
				min-width: 0; /* REQUIRED — the default min-width:auto floors a flex item
				                 at the image's intrinsic width and breaks the row */
			}

			/* thumbnails are anchor links (#photo-N) so the CSS-only lightbox opens */
			.thumb {
				display: block;
				width: 100%;
				padding: 0;
				border: 0;
				background: none;
				cursor: zoom-in;
				color: inherit;
				text-decoration: none;
			}

			.thumb:focus-visible {
				outline: 3px solid var(--taupe);
				outline-offset: 4px;
			}

			/* No aspect-ratio and no object-fit: width:100% + height:auto IS the
			   uncropped guarantee. No border or shadow either — the framed look
			   stays on the review cards above, and this block is a tight mosaic. */
			.thumb img {
				display: block;
				width: 100%;
				height: auto;
			}

			/* The scrim covers as much of the photo as its own text needs, rather
			   than a fixed strip: these captions run 99-310 characters, and a
			   3-line clamp on a 232px-wide portrait tile dropped ~40% of the text. */
			figcaption {
				position: absolute;
				inset-inline: 0;
				bottom: 0;
				max-height: 100%;
				margin: 0;
				padding: 2.25rem 0.9rem 0.85rem;
				font-family: var(--font-italic);
				font-style: italic;
				font-size: var(--step--1);
				line-height: 1.35;
				color: var(--cream);
				background: linear-gradient(
					to top,
					rgba(20, 16, 8, 0.93) 0%,
					rgba(20, 16, 8, 0.88) 55%,
					rgba(20, 16, 8, 0) 100%
				);
				text-wrap: pretty;
				overflow: hidden;
				opacity: 0;
				transition: opacity 180ms ease;
				pointer-events: none; /* never intercept the click to the lightbox */
			}

			/* Two conditions, both necessary. `hover` because a scrim you cannot
			   reveal is dead weight on touch. `min-width: 60rem` because below it
			   the tiles are too small to hold these captions — measured, the scrim
			   swells to 95% of the photo at a 761px container and starts truncating
			   again by 647px. Nothing is lost where it is suppressed: the lightbox
			   carries the same text. */
			@media (hover: hover) and (min-width: 60rem) {
				.gallery-item:hover figcaption,
				.gallery-item:focus-within figcaption {
					opacity: 1;
				}
			}

			@media (prefers-reduced-motion: reduce) {
				figcaption {
					transition: none;
				}
			}

			/* Phones: one full-width column. No hover, so the scrim would never be
			   reachable — drop it and set the caption below the photo, where a single
			   column has room and there is no mosaic rhythm left to protect.
			   `display: block` rather than `flex-direction: column` so that --r is
			   unambiguously inert rather than quietly not mattering. */
			@media (max-width: 40rem) {
				.row {
					display: block;
					max-width: none;
				}

				.gallery-item {
					width: 100%;
				}

				/* The caption belongs to the photo above it, so it sits tight
				   under that photo and the mosaic gap moves to between the pairs.
				   The other way round reads as a caption floating between two
				   photos, closer to the one it does not describe. */
				.gallery-item + .gallery-item {
					margin-top: var(--space-s);
				}

				figcaption {
					position: static;
					opacity: 1;
					padding: var(--gap) 0 0;
					background: none;
					color: var(--taupe); /* light-page colour */
					line-height: 1.4;
					overflow: visible;
					transition: none;
				}
			}
		}

		/* ---- lightbox (pure CSS :target overlay — no JavaScript) ---- */
		.lightbox {
			display: none;
			position: fixed;
			inset: 0;
			z-index: 100;
			place-items: center;
			padding: var(--space-l);
			color: var(--cream);
			background: rgba(10, 8, 4, 0.9);
		}

		/* revealed only while its `#photo-N` hash is active */
		.lightbox:target {
			display: grid;
		}

		/* ---- no lightbox on phones ----
		   Under 40rem the gallery is already a single full-width column with the
		   caption printed below each photo, so the overlay only added a modal to
		   dismiss — it showed the same photo at the same width. Suppressed here
		   rather than in the markup because the site is JavaScript-free and every
		   viewport is served the identical HTML; `pointer-events` makes the
		   thumbnail inert so a tap cannot push a dead `#photo-N` onto the history
		   stack. Same 40rem boundary as the single-column tier above. */
		@media (max-width: 40rem) {
			.lightbox,
			.lightbox:target {
				display: none;
			}

			.photo-gallery .thumb {
				pointer-events: none;
				cursor: default;
			}
		}

		/* full-viewport click-catcher behind the frame — clicking it closes */
		.lb-backdrop {
			position: fixed;
			inset: 0;
			z-index: 1;
			cursor: zoom-out;
		}

		.lb-frame {
			position: relative;
			z-index: 2;
			display: grid;
			grid-template-rows: 1fr auto;
			gap: var(--space-s);
			max-height: 90vh;
			/* 100% (not 96vw) so the frame fits INSIDE .lightbox's padding — on
			   narrow screens 96vw + padding overflowed the viewport and clipped
			   the photo's right edge. min-width:0 lets it shrink below content. */
			width: min(72rem, 100%);
			max-width: 100%;
			min-width: 0;
			margin: 0;
		}

		.lb-stage {
			position: relative;
			display: grid;
			place-items: center;
			/* reserve height so the loading frame is stable and the image loads in
			   without the frame jumping open */
			min-height: 70vh;
		}

		/* The <picture> wraps the <img> and is sized to it, so its pulsing background
		   fills the whole frame the image loads into. Each photo then fades in over
		   the panel (see lb-reveal), so every photo visibly "loads in" rather than
		   snapping in. Pure CSS — no load event. */
		.lb-stage picture {
			display: block;
			line-height: 0;
			/* keep the picture (the grid item) from growing to the image's
			   intrinsic width and overflowing the stage on narrow viewports */
			max-width: 100%;
			min-width: 0;
			border: 1px solid var(--light-beige);
			box-shadow: 0 10px 40px rgba(0, 0, 0, 0.6);
			background-color: rgba(212, 201, 180, 0.08);
			animation: lb-pulse 1.5s ease-in-out infinite;
		}

		.lb-stage img {
			display: block;
			max-width: 100%;
			max-height: 78vh;
			width: auto; /* keep intrinsic aspect ratio (portrait and landscape) */
			height: auto;
			animation: lb-reveal 1.1s ease both;
		}

		/* pulsing placeholder that fills the loading frame */
		@keyframes lb-pulse {
			0%,
			100% {
				background-color: rgba(212, 201, 180, 0.06);
			}
			50% {
				background-color: rgba(212, 201, 180, 0.2);
			}
		}

		/* hold the frame briefly, then fade the photo in */
		@keyframes lb-reveal {
			0%,
			55% {
				opacity: 0;
			}
			100% {
				opacity: 1;
			}
		}

		/* honour reduced-motion: no pulse, no fade */
		@media (prefers-reduced-motion: reduce) {
			.lb-stage picture,
			.lb-stage img {
				animation: none;
			}
		}

		.lb-cap {
			text-align: center;
			font-family: var(--font-italic);
			font-style: italic;
			font-size: var(--step-0);
			color: var(--light-beige);
			line-height: 1.45;
			max-width: 60ch;
			margin-inline: auto;
			min-height: 1.5em;
		}

		/* counter + controls are fixed to the viewport so nothing shifts between photos */
		.lb-count {
			position: fixed;
			top: 1.25rem;
			left: 1.25rem;
			z-index: 10;
			display: block;
			font-family: var(--font-body);
			font-style: normal;
			font-size: var(--step--1);
			color: var(--light-beige);
			font-variant-numeric: tabular-nums;
			letter-spacing: 0.03em;
		}

		.lb-btn,
		.lb-close {
			position: fixed;
			z-index: 10;
			display: grid;
			place-items: center;
			background: rgba(0, 0, 0, 0.6);
			color: var(--cream);
			border: 1px solid var(--battleship-gray);
			border-radius: 50%;
			line-height: 1;
			text-decoration: none;
			cursor: pointer;
		}

		/* geometrically symmetric SVG icons — centred exactly by the grid, unlike
		   the ✕/‹/› text glyphs, whose side-bearings sat them off-centre */
		.lb-icon {
			display: block;
			width: 45%;
			height: 45%;
			fill: none;
			stroke: currentColor;
			stroke-width: 2;
			stroke-linecap: round;
			stroke-linejoin: round;
		}

		.lb-btn:hover,
		.lb-close:hover {
			background: rgba(0, 0, 0, 0.8);
		}

		.lb-btn:focus-visible,
		.lb-close:focus-visible {
			outline: 3px solid var(--light-beige);
			outline-offset: 2px;
		}

		.lb-btn {
			top: 50%;
			transform: translateY(-50%);
			width: 3rem;
			height: 3rem;
		}

		.lb-prev {
			left: 0.5rem;
		}

		.lb-next {
			right: 0.5rem;
		}

		.lb-close {
			top: 1rem;
			right: 1rem;
			width: 2.6rem;
			height: 2.6rem;
		}

		/* mobile: reclaim the fluid space-l padding so the photo fills more of the
		   screen, and drop the prev/next controls to the bottom corners (out of the
		   photo, easier to reach with a thumb)

		   NOTE: currently unreachable — the block above hides .lightbox entirely
		   below this same 40rem breakpoint. Kept, not deleted, because it is
		   measured phone styling and the "no lightbox on phones" decision is one
		   media query away from being reverted. Delete both together if that
		   decision hardens. */
		@media (max-width: 40rem) {
			.lightbox {
				padding: var(--space-s);
			}

			.lb-btn {
				top: auto;
				bottom: 1.1rem;
				transform: none;
				width: 2.75rem;
				height: 2.75rem;
			}

			.lb-prev {
				left: 0.25rem;
			}

			.lb-next {
				right: 0.25rem;
			}

			/* keep the caption clear of the bottom-corner arrows */
			.lb-cap {
				padding-inline: 3.5rem;
				padding-bottom: 3.25rem;
			}
		}
	</style>
</section>
