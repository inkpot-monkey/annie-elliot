{
  "name": "annie-elliot",
  "version": "0.0.1",
  "description": "A website for the novel Mr & Mrs Dickens, Her Story by the author Annie Elliot",
  "type": "module",
  "main": "index.js",
  "homepage": "https://annieelliot.co.uk",
  "scripts": {
    "build": "npx @11ty/eleventy",
    "dev": "npx @11ty/eleventy --serve --incremental",
    "debug": "DEBUG=Eleventy* npx @11ty/eleventy",
    "test:seo": "node scripts/test-seo.js",
    "test:a11y": "node scripts/test-a11y.js",
    "test:lighthouse": "lighthouse http://localhost:8080 --output html --output-path ./lighthouse-report.html --only-categories=accessibility,seo",
    "test:html": "html-validate dist/**/*.html",
    "test:links": "blc http://localhost:8080 -ro --exclude-external",
    "test:all": "npm run test:seo && npm run test:html"
  },
  "keywords": [
    "annie elliot",
    "charles dickens",
    "book",
    "novel",
    "author website",
    "literary fiction"
  ],
  "author": "Pale Blue Bytes",
  "license": "ISC",
  "packageManager": "pnpm@10.13.1",
  "dependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-img": "^6.0.4",
    "@11ty/eleventy-plugin-webc": "^0.11.2",
    "dotenv": "^17.2.2"
  },
  "devDependencies": {
    "broken-link-checker": "^0.7.8",
    "html-validate": "^10.3.1",
    "lighthouse": "^13.0.1",
    "pa11y": "^9.0.1",
    "prettier": "^3.6.2",
    "puppeteer": "^24.30.0"
  }
}
